# Server credential only. Never commit a real key.
AIS3_API_KEY=

# Non-secret Core settings live in .ctfmem/core-config.json; run scripts/memory-core-init.sh
# (or the PowerShell equivalent). Human CLI settings live in .ctfmem/client-config.json;
# run ctfmem setup. Neither client nor Core reads non-secret settings from this file.

# Agent-run convenience values for ctfmem-web. These are shell variables rather than
# values read automatically by ctfmem-web: pass them explicitly to the matching flags.
# Keep the workspace restricted to player-facing challenge files; do not point it at a
# challenge root that also contains solution/.
CTFMEM_AGENT_WORKSPACE=./test-challenge-set/crypto/SekaiCTF2025-ssss/dist
CTFMEM_AGENT_RUNTIME_DIR=./.ctfmem/web-agent
CTFMEM_CORE_PORT=8777
CTFMEM_WEB_PORT=8787
# `fake` is deterministic and offline. Use `ais3` for AIS3 directly or through LiteLLM.
CTFMEM_SUMMARIZER_MODE=fake
CTFMEM_CHALLENGE_TEMPLATE=crypto
CTFMEM_CHALLENGE_TITLE=Test: SekaiCTF 2025 SSSS
# Set to 1 only when scripts/ctfmem-dev.sh should create the configured challenge if absent.
CTFMEM_AUTO_CREATE_CHALLENGE=0
# Example:
# ctfmem-web --agent-workspace "$CTFMEM_AGENT_WORKSPACE" \
#   --agent-runtime-dir "$CTFMEM_AGENT_RUNTIME_DIR"
