# AIS3 summarizer backend (OpenAI-compatible Chat Completions).
# Source: https://github.com/chunying/ais3-ai-infra
# Never commit a real key.
AIS3_BASE_URL=https://llm-api.zoolab.org/v1
AIS3_API_KEY=
AIS3_SUMMARIZER_MODEL=ais3/nemotron-3-ultra-550b
# Read timeout for one summarize call, in seconds. Measured latency against the real
# backend varied from ~14s to ~57s for an identical prompt, so leave room.
AIS3_TIMEOUT=300

# Memory Core server URL (shared by server and clients)
MEMORY_CORE_URL=http://127.0.0.1:8777

# Memory Core paths
MEMORY_CORE_RUNS_DIR=./runs
MEMORY_CORE_TEMPLATES_DIR=./templates

# Human Client settings. The Human Client talks only to Memory Core and must not receive
# AIS3_API_KEY.
MEMORY_CORE_BASE_URL=http://127.0.0.1:8000
MEMORY_CORE_CHALLENGE_ID=demo
MEMORY_CORE_ACTOR=human
MEMORY_CORE_CLIENT_TIMEOUT=30
