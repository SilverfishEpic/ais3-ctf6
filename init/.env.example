# ──────────────────────────────────────────────────────────────
# claude_loop 環境變數設定
# ──────────────────────────────────────────────────────────────
# 複製為 .env 並填入你的設定值。
# 不要把含真實金鑰的 .env 提交到 Git。

# --- AIS3 Summarizer（Memory Core 的摘要引擎）---
# OpenAI-compatible Chat Completions API 端點
AIS3_BASE_URL=https://llm-api.zoolab.org/v1
# API 金鑰（必填，Memory Core 啟動時會檢查）
AIS3_API_KEY=
# 摘要用的模型名稱
AIS3_SUMMARIZER_MODEL=ais3/nemotron-3-ultra-550b
# 單次呼叫 timeout（秒）。實測延遲約 14–57s，留餘裕
AIS3_TIMEOUT=300

# --- Memory Core 路徑 ---
# runs 目錄：存放執行紀錄 state.yaml
MEMORY_CORE_RUNS_DIR=./runs
# templates 目錄：各題型模板 *.yaml
MEMORY_CORE_TEMPLATES_DIR=./templates

# --- Claude Agent SDK ---
# 選擇性：指定 Claude Agent SDK 使用的模型
# CLAUDE_MODEL=claude-sonnet-4-20250514
